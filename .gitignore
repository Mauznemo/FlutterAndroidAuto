# Dart / Flutter
.dart_tool/
.packages
.pub-cache/
.pub/
build/
pubspec.lock
# ...except the workspace root's, which is the only one that exists now: `flutter pub
# get` at the root resolves all four packages together into this single lockfile, and a
# repository containing an application commits it so a build is reproducible.
!/pubspec.lock
*.iml
.idea/
.vscode/
.flutter-plugins
.flutter-plugins-dependencies

# Generated plugin registrants, regenerated by the tooling on every build
example/linux/flutter/generated_plugin_registrant.cc
example/linux/flutter/generated_plugin_registrant.h
example/linux/flutter/generated_plugins.cmake

# Native build output
packages/android_auto_linux/linux/third_party/*/build/
compile_commands.json

# Custom head unit certificates, never commit these
**/custom_headunit.crt
**/custom_headunit.key

# OS
.DS_Store

# dev/release_support.py is imported by nothing, but running it leaves this behind.
__pycache__/
*.pyc
