diff --git a/include/aasdk/Common/Strand.hpp b/include/aasdk/Common/Strand.hpp
new file mode 100644
index 0000000..8b54d2f
--- /dev/null
+++ b/include/aasdk/Common/Strand.hpp
@@ -0,0 +1,68 @@
+// This file is part of aasdk library project.
+// Copyright (C) 2018 f1x.studio (Michal Szwaj)
