@@ -248,7 +248,13 @@ else()
     message(STATUS "Skipping Abseil requirement - using system protobuf")
 endif()
 
-find_package(Boost REQUIRED COMPONENTS system log_setup log OPTIONAL_COMPONENTS unit_test_framework)
+if(AASDK_TEST)
+    find_package(Boost REQUIRED COMPONENTS log_setup log OPTIONAL_COMPONENTS unit_test_framework)
+else()
+    # Boost.Test is a test only dependency, and asking for it here would put it in
+    # aasdk's PUBLIC link interface and so in every consumer's DT_NEEDED.
+    find_package(Boost REQUIRED COMPONENTS log_setup log)
+endif()
 
 # Capture Boost version for packaging
 if(Boost_VERSION)
@@ -283,25 +289,33 @@ file(GLOB_RECURSE tests_include_files ${include_ut_directory}/*.hpp)
 
 list(REMOVE_ITEM source_files ${tests_source_files})
 
+# The parent project decides. aasdk linked into another shared library wants
+# STATIC: the date based SONAME below makes a shared aasdk awkward to redistribute.
+set(AASDK_LIBRARY_TYPE "SHARED" CACHE STRING "aasdk library type: SHARED or STATIC")
+
 if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")  # macOS
     message(NOTICE "Configuring STATIC Library for MacOS")
     add_library(aasdk STATIC
             ${source_files}
             ${include_files})
 else()
-    message(NOTICE "Configuring SHARED Library")
-    add_library(aasdk SHARED
+    message(NOTICE "Configuring ${AASDK_LIBRARY_TYPE} Library")
+    add_library(aasdk ${AASDK_LIBRARY_TYPE}
             ${source_files}
             ${include_files})
 endif()
 if(SKIP_BUILD_PROTOBUF)
     target_include_directories(aasdk PUBLIC
+        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
+        $<INSTALL_INTERFACE:include>
         $<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}/protobuf>
         $<BUILD_INTERFACE:${Protobuf_INCLUDE_DIRS}>
         $<INSTALL_INTERFACE:include/aap_protobuf>
     )
 else()
     target_include_directories(aasdk PUBLIC
+        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
+        $<INSTALL_INTERFACE:include>
         $<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}/protobuf>
         $<BUILD_INTERFACE:${protobuf_SOURCE_DIR}/src>
         $<INSTALL_INTERFACE:include/aap_protobuf>
